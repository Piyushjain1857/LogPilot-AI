APP_NAME=LogPilot AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./logpilot.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=true
AI_AUTO_ANALYSIS=true
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60
AI_CONFIDENCE_THRESHOLD=0.80
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_RECORDS=100000
MAX_UPLOAD_FILES=5
MAX_LOG_MESSAGE_BYTES=32768
MAX_PREVIEW_RECORDS=50
MAX_INGESTION_ERRORS=100
INGESTION_BATCH_SIZE=500
MAX_CONCURRENT_INGESTION_JOBS=2
UPLOAD_TEMP_DIRECTORY=storage/uploads
ENABLE_SECRET_REDACTION=true
LOG_LEVEL=INFO
ENABLE_REMEDIATION_EXECUTION=false
ENABLE_REALTIME_INGESTION=true
ENABLE_WEBSOCKET_STREAMING=true
MAX_INGESTION_BATCH_SIZE=500
MAX_INGESTION_REQUEST_BYTES=2097152
MAX_INGESTION_QUEUE_SIZE=5000
INGESTION_WORKER_COUNT=1
INGESTION_FLUSH_INTERVAL_MS=250
INGESTION_REQUESTS_PER_MINUTE=120
INGESTION_RECORDS_PER_MINUTE=10000
MAX_WEBSOCKET_CLIENTS=20
MAX_WEBSOCKET_CLIENT_QUEUE=500
MAX_WEBSOCKET_MESSAGE_BYTES=16384
WEBSOCKET_HEARTBEAT_INTERVAL=20
WEBSOCKET_CONNECTION_TIMEOUT=60
STREAM_EVENT_RETENTION_HOURS=24
SOURCE_ACTIVE_WINDOW_SECONDS=60
SOURCE_IDLE_WINDOW_SECONDS=300
STREAM_METRICS_WINDOW_SECONDS=300
